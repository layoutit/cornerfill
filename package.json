{
  "name": "cornerfill",
  "version": "0.0.0",
  "private": true,
  "description": "Live CSS-image corner-shape fallback for Safari and Firefox",
  "license": "MIT",
  "type": "module",
  "files": [
    "src/"
  ],
  "exports": {
    ".": "./src/index.mjs",
    "./geometry": "./src/geometry.mjs",
    "./values": "./src/values.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "oracle:list": "node scripts/oracle.mjs list",
    "oracle:smoke": "node scripts/oracle.mjs run --cases=bevel,round,mario-texel-face",
    "oracle:cross": "node scripts/oracle.mjs run --browsers=chrome,webkit,firefox --cases=bevel,bevel-rotated,mario-texel-face",
    "oracle:run": "node scripts/oracle.mjs run",
    "oracle:check": "node scripts/oracle.mjs run --enforce-candidate",
    "test:browser:runtime": "node scripts/runtime-regressions.mjs",
    "perf:firefox:mario": "node scripts/trace-firefox-mario.mjs --headless"
  }
}
