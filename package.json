{
  "name": "cornerfill",
  "version": "0.1.0",
  "description": "Native-first paint polyfill for CSS corner-shape in Safari and Firefox",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/auto.mjs"
  ],
  "files": [
    "src/"
  ],
  "exports": {
    ".": "./src/auto.mjs",
    "./runtime": "./src/runtime.mjs",
    "./geometry": "./src/geometry.mjs",
    "./values": "./src/values.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/layoutit/cornerfill.git"
  },
  "bugs": {
    "url": "https://github.com/layoutit/cornerfill/issues"
  },
  "homepage": "https://github.com/layoutit/cornerfill#readme",
  "keywords": [
    "css",
    "corner-shape",
    "polyfill",
    "safari",
    "firefox"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node --test",
    "test:browser:runtime": "node scripts/runtime-regressions.mjs"
  }
}
